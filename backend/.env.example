
# SQL Server
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=SUNOVA;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;
DB_USERNAME=sa
DB_PASSWORD=

# JWT (>= 32 ký tự)
JWT_SECRET=

# Gemini (chat AI)
