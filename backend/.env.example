VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/callback
VNPAY_IPN_URL=http://localhost:8080/api/payments/vnpay/ipn
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/dat-hang

# Gmail (App Password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Storefront
FRONTEND_BASE_URL=http://localhost:5173

# GHN — sandbox: https://dev-online-gateway.ghn.vn/shiip/public-api
# GHN — production: https://online-gateway.ghn.vn/shiip/public-api
# Token/ShopId phải cùng môi trường với GHN_BASE_URL (dev token không dùng được kho production).
# Địa chỉ 2 cấp: tạo đơn/tính phí theo TÊN (to_province_name + to_ward_name).
# Khai báo tên kho gửi 2 cấp; nếu trống GHN tự lấy kho theo ShopId.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_WARD_NAME=
GHN_FROM_PROVINCE_NAME=
GHN_SHOP_PHONE=
